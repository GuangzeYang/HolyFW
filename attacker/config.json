{
  "batch_size": 5,
  "poll_interval_seconds": 15,
  "base_time": 9,
  "exec": {
    "timeout_seconds": 900
  },
  "generator": {
    "max_attempts": 5,
    "generation_retry_interval_seconds": 1800,
    "time_model": {
      "tasks_per_role": 39,
      "mu_am_minutes": 630,
      "mu_pm_minutes": 900,
      "sigma_am_minutes": 50,
      "sigma_pm_minutes": 65,
      "a_am": 1.0,
      "a_pm": 1.0,
      "phi": 0.85,
      "sigma_eta": 0.18,
      "avoid_five_minutes": true
    },
    "api_base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "request_timeout_seconds": 300,
    "max_tokens": 32776,
    "planner": {
      "recent_action_limit": 20,
      "foothold_max_discovery_per_batch": 1,
      "foothold_min_collection_lateral": 2,
      "min_batch_for_collection_quota": 3,
      "max_same_technique": 2,
      "cooldowns_hours": {
        "success": 12,
        "failure": 2,
        "discovery.orientation": 24,
        "discovery.host-scan": 24,
        "discovery.port-scan": 12,
        "discovery.share-enum": 4
      }
    }
  },
  "paths": {
    "data_dir": "role_task",
    "logs_dir": "logs"
  },
  "extract": {
    "lab_nets": ["172.16.24.0/24"],
    "attacker_ip": "",
    "exclude_flows": [
      {"peer_ip": "172.16.24.42", "image_contains": "avp"}
    ]
  }
}
