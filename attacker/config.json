{
  "batch_size": 5,
  "poll_interval_seconds": 15,
  "base_time": 21,
  "exec": {
    "timeout_seconds": 900
  },
  "generator": {
    "max_attempts": 5,
    "time_model": {
      "tasks_per_role": 39,
      "mu_am_minutes": 630,
      "mu_pm_minutes": 900,
      "sigma_am_minutes": 50,
